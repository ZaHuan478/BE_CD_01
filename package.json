{
  "name": "hrm-sop-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:setup": "tsx src/database/setup.ts",
    "db:transfer:mysql-to-sqlserver": "tsx src/database/sqlserver-transfer-cli.ts",
    "db:transfer:mysql-to-sqlserver:prod": "node dist/database/sqlserver-transfer-cli.js",
    "db:backup:sqlserver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-sqlserver.ps1",
    "db:demo-governance": "tsx scripts/seed-demo-governance.ts",
    "db:ensure-full-operator": "tsx scripts/ensure-demo-full-operator.ts",
    "db:document-conversions:reprocess": "tsx scripts/reprocess-document-conversions.ts",
    "db:knowledge:plan": "tsx src/database/knowledge-cli.ts",
    "db:knowledge:apply": "tsx src/database/knowledge-cli.ts --apply",
    "db:knowledge:verify": "tsx src/database/knowledge-cli.ts --verify",
    "db:core8:plan": "tsx src/database/core8-cli.ts plan",
    "db:core8:apply": "tsx src/database/core8-cli.ts apply",
    "db:core8:verify": "tsx src/database/core8-cli.ts verify",
    "db:core8:setup": "tsx src/database/core8-cli.ts setup",
    "db:core8:seed-demo": "tsx src/database/core8-cli.ts seed-demo",
    "lint": "oxlint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node scripts/clean.mjs",
    "db:setup:prod": "node dist/database/setup.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@sinclair/typebox": "^0.34.52",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.3",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.5.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
