NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Local development only: requests use x-user-id (defaults to demo-admin).
AUTH_MODE=development
DEVELOPMENT_DEMO_PASSWORD=123456

# Required when AUTH_MODE=jwt. Replace with the HRM identity provider setup later.
JWT_SECRET=change-me-outside-source-control
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=hrm-sop-api

SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=HrmSopKnowledge
SQL_USER=sa
SQL_PASSWORD=change-me-outside-source-control
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_POOL_MAX=10

# Used only by compose.yaml to start a local SQL Server container.
SQL_ADMIN_PASSWORD=change-me-outside-source-control
