NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
SOP_UPLOAD_DIR=data/uploads/sop-imports
SOP_UPLOAD_MAX_BYTES=10485760

# Local development only: requests use x-user-id (required).
AUTH_MODE=development
DEVELOPMENT_DEMO_PASSWORD=123456

# Required when AUTH_MODE=jwt. Replace with the HRM identity provider setup later.
JWT_SECRET=change-me-outside-source-control
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=hrm-sop-api

# Active runtime database. SQL Server is the primary database after cutover.
DB_PROVIDER=sqlserver

# MySQL is retained as the source and rollback database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hrm_sop
MYSQL_USER=hrm_sop_app
MYSQL_PASSWORD=change-me-outside-source-control
MYSQL_POOL_MAX=10

# SQL Server target. SQL authentication is used by the Node.js `mssql` driver.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=hrm_sop_sqlserver
SQLSERVER_USER=hrm_sop_app
SQLSERVER_PASSWORD=change-me-outside-source-control
SQLSERVER_POOL_MAX=10
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_REQUEST_TIMEOUT_MS=30000
SQLSERVER_TRANSFER_REQUEST_TIMEOUT_MS=120000
# The transfer command creates the named database only when this is explicitly true.
SQLSERVER_CREATE_DATABASE=false

# Legacy aliases remain supported so existing local .env files keep working with MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=hrm_sop
# DB_USER=hrm_sop_app
# DB_PASSWORD=change-me-outside-source-control
# DB_POOL_MAX=10

# Used only by compose.yaml to start a local MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root-password

# Initialize schema and import the local snapshot before HTTP starts.
# Production: prefer DB_INITIALIZE_ON_START=false and run db:setup as a deployment step.
DB_INITIALIZE_ON_START=true
DB_IMPORT_SNAPSHOT=data/import/legacy-snapshot.json

# For a fresh demo ONLY: leave DB_IMPORT_SNAPSHOT empty and enable this flag.
# Never enable demo seeding when migrating real data.
DB_SEED_DEMO=false

# Only switch AFTER db:knowledge:apply and db:knowledge:verify succeed.
# This switches /knowledge-documents and /knowledge-search. Legacy diagram datasets stay compatible.
KNOWLEDGE_READ_SOURCE=legacy

# Set core8 ONLY after db:core8:apply + verify, or db:core8:setup on an empty DB.
# core8 always uses document versions and ignores KNOWLEDGE_READ_SOURCE.
DB_MODEL=legacy

# Optional Cloudinary storage (complete credential set required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DOCUMENT_FOLDER=hrm_documents

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_CHAT_MODEL=gemini-2.5-flash
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CHUNK_MAX_TOKENS=500
